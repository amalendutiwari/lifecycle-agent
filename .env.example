# Copy to .env and fill in. Do not commit .env.

# The resource your DEPLOYMENT lives on - for this project that is the Foundry
# resource in westus3, NOT the OmronLifecycle resource in eastus.
# Must end with /openai/v1/
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/openai/v1/

# The DEPLOYMENT name you chose in Foundry, not the model name.
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini-1

# Leave blank to use `az login` + DefaultAzureCredential (preferred - it is the
# version that survives a security review). Set a key only as a fallback.
AZURE_OPENAI_API_KEY=

# --- optional ---
# DATASET=data/lifecycle_synthetic_100.csv
# STATUS_MAP=data/status_map.yaml
# NARROW_THRESHOLD=10
# MAX_RESULTS=15
